# Public Google OAuth client id for frontend sign-in button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Public API URL used by browser requests
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Browser-facing API URL (preferred when set)
NEXT_PUBLIC_BROWSER_API_URL=http://localhost:8000/api/v1

# Optional server-side API URL for SSR routes
BACKEND_INTERNAL_API_URL=http://localhost:8000/api/v1

# Optional default locale (ro or en)
NEXT_PUBLIC_DEFAULT_LOCALE=ro
